--- rand-js tests — the `seeded_*` family is pure handl (the `_smix`
--- LCG PRNG, no `js.call`), so it is fully testable here. The unseeded
--- arrows and `seeded_gauss` go through `js.call`/`Math.*` and need a
--- JS host, so they are not exercised.
---
--- `_smix(1, k)` values (mod 2^32): k=0 -> 3027450565, k=1 -> 3186434646,
--- k=2 -> 3345418727.

from "./index" import * as m

test_seeded_int := assert m.seeded_int(1, 10) == 7

test_seeded_float := assert m.seeded_float(1, 1) == 3027450565 / 4294967296

test_seeded_bool := assert m.seeded_bool(1) == false

test_seeded_pick := assert m.seeded_pick(1, [10, 20, 30]) == 20

-- seeded_choice draws with replacement over the fixed list:
-- k=0 -> 3027450565 % 3 = 1 -> xs[1]; k=1 -> 3186434646 % 3 = 0 -> xs[0]
test_seeded_choice := assert m.seeded_choice(1, [1, 2, 3], 2) == [2, 1]

-- seeded_sample removes picks: k=0 -> xs[1]=2, k=1 -> 3186434646 % 2 = 0 -> 1
test_seeded_sample := assert m.seeded_sample(1, [1, 2, 3], 2) == [2, 1]

test_seeded_sample_empty := assert m.seeded_sample(1, [], 3) == []

-- seeded_shuffle = seeded_sample over the whole list
test_seeded_shuffle := assert m.seeded_shuffle(1, [1, 2, 3]) == [2, 1, 3]

-- seeded_string: charset indices [1, 0, 2] -> "bac"
test_seeded_string := assert m.seeded_string(1, 3, "abc") == "bac"

test_seeded_string_empty := assert m.seeded_string(1, 0, "abc") == ""

-- determinism
test_seeded_deterministic := assert m.seeded_int(7, 100) == m.seeded_int(7, 100)

test_seeded_differs := assert m.seeded_int(1, 100) != m.seeded_int(2, 100)
