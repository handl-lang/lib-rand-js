--- The JavaScript `Math.random` backend for random values.
---
--- @details
--- All unseeded values derive from `next_u32`, which draws
--- `Math.random()` (a `[0, 1)` double) through `js.call` and scales it
--- to a `[0, 2^32)` integer-valued float — the same surface
--- `rand-c.entropy.next_u32` provides, so the selection/distribution
--- logic below mirrors `rand-c` arrow for arrow. Float helpers that
--- `rand-c` takes from `math.*` host ops (`sqrt`, `log`, `cos`, `exp`)
--- go through `js.call("Math", ...)` here, since a JS host is not
--- guaranteed the native `math` op surface; everything else is plain
--- handl arithmetic (`+ - * / %`).
---
--- `Math.random` cannot be seeded, so the `seeded_*` family uses a
--- small pure-handl PRNG instead of host entropy: `_smix(seed, k)`
--- mixes `(seed, k)` into a 32-bit LCG state (Numerical Recipes
--- constants `1664525`/`1013904223`, four warm-up rounds) and returns
--- a `[0, 2^32)` value. Every intermediate product stays below 2^53,
--- so f64 arithmetic is exact. It is deterministic and reasonably
--- mixed for simulation use, but it is NOT cryptographically secure —
--- same status as `rand-c`'s `hash`, which this replaces.
---
--- `char.chars` for `string`/`seeded_string` resolves through the
--- ambient `char` package exactly as it does in `rand-c`/`rand-stub`.

from "js" import { call }

do {
  -- -----------------------------------------------------------------------
  -- Internal list helpers (same shapes as rand-c)
  -- -----------------------------------------------------------------------

  arr_len := (xs) ~> do {
    while { xs: xs, n: 0 } {
      [xs, n] ~> match xs {
        []: { out: n },
        [_, ...t]: { state: { xs: t, n: n + 1 } }
      }
    }
  }

  arr_rev := (xs) ~> do {
    while { xs: xs, acc: [] } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
      }
    }
  }

  arr_take := (xs, n) ~> do {
    while { xs: xs, n: n, acc: [] } {
      [xs, n, acc] ~> if n <= 0 {
        { out: arr_rev(acc) }
      } else {
        match xs {
          []: { out: arr_rev(acc) },
          [h, ...t]: { state: { xs: t, n: n - 1, acc: [h, ...acc] } }
        }
      }
    }
  }

  arr_drop := (xs, n) ~> do {
    while { xs: xs, n: n } {
      [xs, n] ~> if n <= 0 {
        { out: xs }
      } else {
        match xs {
          []: { out: [] },
          [_, ...t]: { state: { xs: t, n: n - 1 } }
        }
      }
    }
  }

  arr_concat := (a, b) ~> do {
    while { xs: arr_rev(a), acc: b } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
      }
    }
  }

  arr_remove_at := (xs, i) ~> arr_concat(arr_take(xs, i), arr_drop(xs, i + 1))

  arr_sum := (xs) ~> do {
    while { xs: xs, acc: 0 } {
      [xs, acc] ~> match xs {
        []: { out: acc },
        [h, ...t]: { state: { xs: t, acc: acc + h } }
      }
    }
  }

  -- -----------------------------------------------------------------------
  -- Entropy + float primitives over `js.call("Math", ...)`
  -- -----------------------------------------------------------------------

  -- One 32-bit draw: `Math.random()` is `[0, 1)`; `floor(r * 2^32)` is
  -- `[0, 2^32)` — integer-valued, so `%`/`/` below stay exact.
  next_u32 := () ~> do {
    r := call("Math", "random", [], [], "js_number", false)
    call("Math", "floor", [r * 4294967296], ["js_number"], "js_number", false)
  }

  js_sqrt := (x) ~> call("Math", "sqrt", [x], ["js_number"], "js_number", false)

  js_log := (x) ~> call("Math", "log", [x], ["js_number"], "js_number", false)

  js_cos := (x) ~> call("Math", "cos", [x], ["js_number"], "js_number", false)

  js_exp := (x) ~> call("Math", "exp", [x], ["js_number"], "js_number", false)

  -- pi as a literal (`Math.PI` is a property, and `js.call` only
  -- dispatches functions).
  PI := 3.141592653589793

  -- Seeded PRNG: mix `(seed, k)` into an LCG state, then run four
  -- Numerical-Recipes rounds. `seed`/`k` are first reduced mod 2^32 so
  -- the seed combine stays below 2^33; every LCG product
  -- `s * 1664525 + 1013904223` stays below ~7.2e15 < 2^53, hence exact
  -- in f64. Deterministic per `(seed, k)` — the same index always draws
  -- the same value, which is what the `seeded_*` contract needs.
  _smix := (seed, k) ~> do {
    s0 := (((seed % 4294967296) + (k % 4294967296)) % 4294967296)
    s1 := ((s0 + 4294967296) % 4294967296)
    r1 := (s1 * 1664525 + 1013904223) % 4294967296
    r2 := (r1 * 1664525 + 1013904223) % 4294967296
    r3 := (r2 * 1664525 + 1013904223) % 4294967296
    r4 := (r3 * 1664525 + 1013904223) % 4294967296
    r4
  }

  -- Core selection primitives shared by other arrows.
  pick := (xs) ~> do {
    i := next_u32() % arr_len(xs)
    xs[i]
  }

  sample := (xs, count) ~> do {
    while { xs: xs, n: count, acc: [] } {
      [xs, n, acc] ~> if n <= 0 || arr_len(xs) == 0 {
        { out: arr_rev(acc) }
      } else {
        i := next_u32() % arr_len(xs)
        x := xs[i]
        { state: { xs: arr_remove_at(xs, i), n: n - 1, acc: [x, ...acc] } }
      }
    }
  }

  seeded_sample := (seed, xs, count) ~> do {
    while { xs: xs, n: count, k: 0, acc: [] } {
      [xs, n, k, acc] ~> if n <= 0 || arr_len(xs) == 0 {
        { out: arr_rev(acc) }
      } else {
        r := _smix(seed, k)
        i := r % arr_len(xs)
        x := xs[i]
        { state: { xs: arr_remove_at(xs, i), n: n - 1, k: k + 1, acc: [x, ...acc] } }
      }
    }
  }

  -- -----------------------------------------------------------------------
  -- Exports
  -- -----------------------------------------------------------------------

  {
    -- Generate a random integer in `[0, max]`.
    int: (max) ~> next_u32() % (max + 1),

    -- Generate a random float in `[0, max)`.
    float: (max) ~> do {
      u := next_u32()
      (u / 4294967296) * max
    },

    -- Generate a random boolean.
    bool: () ~> next_u32() % 2 == 0,

    -- Pick one random element from a non-empty array.
    pick: pick,

    -- Pick one random element from weighted arrays.
    weighted_pick: (weights, items) ~> do {
      n := arr_len(weights)
      if n == 0 || n != arr_len(items) {
        null
      } else {
        do {
          total := arr_sum(weights)
          if total <= 0 {
            null
          } else {
            do {
              r := next_u32() % total
              while { i: 0, cum: 0 } {
                [i, cum] ~> if i >= n {
                  { out: null }
                } else {
                  w := weights[i]
                  c := cum + w
                  if r < c {
                    { out: items[i] }
                  } else {
                    { state: { i: i + 1, cum: c } }
                  }
                }
              }
            }
          }
        }
      }
    },

    -- Choose `count` elements from an array with replacement.
    choice: (xs, count) ~> do {
      while { n: count, acc: [] } {
        [n, acc] ~> if n <= 0 {
          { out: arr_rev(acc) }
        } else {
          { state: { n: n - 1, acc: [pick(xs), ...acc] } }
        }
      }
    },

    -- Sample `count` elements from an array without replacement.
    sample: sample,

    -- Shuffle an array in random order.
    shuffle: (xs) ~> sample(xs, arr_len(xs)),

    -- Generate `n` random bytes in `[0, 255]`.
    bytes: (n) ~> do {
      while { n: n, acc: [] } {
        [n, acc] ~> if n <= 0 {
          { out: arr_rev(acc) }
        } else {
          { state: { n: n - 1, acc: [next_u32() % 256, ...acc] } }
        }
      }
    },

    -- Generate a random string of `len` characters from `charset`.
    string: (len, charset) ~> do {
      cs := char.chars(charset)
      while { n: len, acc: "" } {
        [n, acc] ~> if n <= 0 {
          { out: acc }
        } else {
          { state: { n: n - 1, acc: acc + pick(cs) } }
        }
      }
    },

    -- Generate a normally distributed number with `mean` and `stddev`.
    -- Box-Muller, same shape as rand-c (`+1` guards `log(0)`).
    gauss: (mean, stddev) ~> do {
      u1 := (next_u32() + 1) / 4294967296
      u2 := (next_u32() + 1) / 4294967296
      r := js_sqrt(0 - 2 * js_log(u1))
      theta := 2 * PI * u2
      z := r * js_cos(theta)
      mean + stddev * z
    },

    -- Generate an exponentially distributed non-negative number with `lambda`.
    exponential: (lambda) ~> do {
      u := (next_u32() + 1) / 4294967296
      (0 - js_log(u)) / lambda
    },

    -- Generate a Poisson-distributed non-negative integer with `lambda`.
    poisson: (lambda) ~> do {
      threshold := js_exp(0 - lambda)
      while { p: 1.0, k: 0 } {
        [p, k] ~> if p <= threshold {
          { out: k }
        } else {
          u := next_u32() / 4294967296
          { state: { p: p * u, k: k + 1 } }
        }
      }
    },

    -- Generate a binomial-distributed integer in `[0, n]` with `n` trials and success probability `p`.
    binomial: (n, p) ~> do {
      while { i: 0, successes: 0 } {
        [i, successes] ~> if i >= n {
          { out: successes }
        } else {
          u := next_u32() / 4294967296
          if u < p {
            { state: { i: i + 1, successes: successes + 1 } }
          } else {
            { state: { i: i + 1, successes: successes } }
          }
        }
      }
    },

    -- Seeded variants (pure-handl PRNG `_smix`; no host entropy)
    seeded_int: (seed, max) ~> _smix(seed, 0) % (max + 1),

    seeded_float: (seed, max) ~> (_smix(seed, 0) / 4294967296) * max,

    seeded_bool: (seed) ~> _smix(seed, 0) % 2 == 0,

    seeded_pick: (seed, xs) ~> do {
      i := _smix(seed, 0) % arr_len(xs)
      xs[i]
    },

    seeded_choice: (seed, xs, count) ~> do {
      n := arr_len(xs)
      if n == 0 {
        []
      } else {
        do {
          while { m: count, k: 0, acc: [] } {
            [m, k, acc] ~> if m <= 0 {
              { out: arr_rev(acc) }
            } else {
              r := _smix(seed, k)
              i := r % n
              { state: { m: m - 1, k: k + 1, acc: [xs[i], ...acc] } }
            }
          }
        }
      }
    },

    seeded_sample: seeded_sample,

    seeded_shuffle: (seed, xs) ~> seeded_sample(seed, xs, arr_len(xs)),

    seeded_string: (seed, len, charset) ~> do {
      cs := char.chars(charset)
      m := arr_len(cs)
      if m == 0 {
        ""
      } else {
        do {
          while { n: len, k: 0, acc: "" } {
            [n, k, acc] ~> if n <= 0 {
              { out: acc }
            } else {
              r := _smix(seed, k)
              i := r % m
              { state: { n: n - 1, k: k + 1, acc: acc + cs[i] } }
            }
          }
        }
      }
    },

    seeded_gauss: (seed, mean, stddev) ~> do {
      s1 := _smix(seed, 0)
      s2 := _smix(seed, 1)
      u1 := (s1 + 1) / 4294967296
      u2 := (s2 + 1) / 4294967296
      r := js_sqrt(0 - 2 * js_log(u1))
      theta := 2 * PI * u2
      z := r * js_cos(theta)
      mean + stddev * z
    }
  }
}
